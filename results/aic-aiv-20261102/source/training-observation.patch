+def test_activity_profile_has_explicit_interior_window_and_scope(tmp_path):
+    row=fixture(tmp_path)
+    row['activity_profile']=dict(start_step=3,stop_step=6,aic_metrics='none',profiler_level=0,activities='npu')
+    assert resolve(row,tmp_path)['activity_profile']==row['activity_profile']
+    row['activity_profile']['stop_step']=8
+    with pytest.raises(ValueError,match='interior'):resolve(row,tmp_path)
+
+
+@pytest.mark.parametrize('change',[{'activities':'gpu'},{'profiler_level':2},{'aic_metrics':'unknown'},{'extra':True}])
+def test_activity_profile_rejects_unsupported_collection_options(tmp_path,change):
+    row=fixture(tmp_path);row['activity_profile']=dict(start_step=3,stop_step=6,**change)
+    with pytest.raises(ValueError):resolve(row,tmp_path)
