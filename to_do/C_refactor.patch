  /* ===================================================================
   * Dual-Polling Pipeline
   *
   * Drives NPU DMA and SPDK NVMe I/O concurrently.  Three engines run
   * in each iteration:
   *   Engine 1 — submit:  pop free ring slots, launch DMA / SPDK commands
   *   Engine 2 — drain:   poll NPU events, submit ready chunks to SPDK
   *   Engine 3 — reap:    process SPDK completion queue, reclaim slots
   *
   * Stall recovery (two-stage):
   *   Stage 1 (>50 ms no progress):  force-sync one stalled NPU event via
   *     aclrtSynchronizeEvent.  This breaks hardware lazy-suspend or
   *     interrupt-coalescing stalls.
   *   Stage 2 (>3 s no progress):  dump all active task state to stderr
   *     and reset the stall timer.  This is a diagnostic aid, not a fix.
   * =================================================================== */

  ...
  // Stage 1: force-sync stalled event
  if (stall_time > 50000ULL && stall_time < 3000000ULL) {
      ...
      aclrtSynchronizeEvent(ctx->events[task->buf_idx]);
      task->state = CHUNK_NPU_DONE;
      last_progress_time = get_time_us();
      break;
  }

  // Stage 2: persistent stall — diagnostic dump
  if (stall_time > 3000000ULL) {
      fprintf(stderr, "\n[NPU-NVMe] Pipeline STALL detected (rank %d)\n", ctx->npu_id);
      fprintf(stderr, "[NPU-NVMe] Completed: %d / Total: %d\n",
              completed_tasks, num_tasks);
      fprintf(stderr, "[NPU-NVMe] Active task state dump:\n");
      for (int i = 0; i < submitted_to_npu; i++) {
          if (tasks[i].state != CHUNK_DONE) {
              fprintf(stderr, "  Task %d | Offset %lu | Size %zu | State %d | Buf %d\n",
                      tasks[i].task_idx, tasks[i].nvme_offset, tasks[i].size,
                      tasks[i].state, tasks[i].buf_idx);
          }
      }
      last_progress_time = now;
  }

